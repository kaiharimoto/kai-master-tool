<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed once, to download the card database. Everything afterwards is local. -->
    <!-- Voice input (1.0.57): asked for the first time the microphone is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The system's speech recogniser and text-to-speech, visible to the app (Android 11). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ai at work out of sight (1.0.61): a foreground service keeps the answer from being cut off
         when another app comes up, with a wake lock for a screen that goes off, and a notification
         that says so (asked for once, the first time Ai works; the service runs without it). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the app install the release APK it downloads from GitHub. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MasterToolApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MasterTool">

        <!-- Neue turns as its Screen setting says (v1.3.5): Portrait, Landscape or
             Auto, a phone upright and a tablet lying down by default. The
             activity sets that at runtime (MainActivity.applyOrientation) before
             its first frame; fullUser here only means nothing is locked before
             it does. The config changes listed are the ones Neue lays itself out
             for rather than being recreated — a turn and a keyboard attached or
             detached included, or the deck being edited would go with them. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MasterTool"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open .ydk / .ydkx files shared from other apps, and .ydkw webs (1.0.33). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ydk" />
                <data android:pathPattern=".*\\.ydkx" />
                <data android:pathPattern=".*\\.ydkw" />
            </intent-filter>

            <!-- Back from the browser after signing in to a cloud for sync (1.0.68). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neuemastertool" android:host="signed-in" />
            </intent-filter>
        </activity>

        <!-- The camera screen that scans a deck's QR code (v1.3.7), and every part of
             a split one (1.0.32): ScanActivity, on ZXing's embedded scanner view,
             which brings the CAMERA permission; the activity asks for it on first
             use. It turns with the phone, and keeps the parts it has read across
             the turn. -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.MasterTool" />

        <service
            android:name=".AiWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
